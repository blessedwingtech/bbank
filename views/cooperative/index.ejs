<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold text-dark mb-1">Coopérative, Mutuelle & Tontines</h2>
    <p class="text-muted mb-0">Gestion participative du sociétariat, des parts sociales et des cercles d'épargne rotative.</p>
  </div>
  <div class="d-flex gap-2">
    <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#buySharesModal">
      <i class="fa-solid fa-certificate me-1"></i> Souscrire des parts
    </button>
    <% if (locals.user && (locals.user.role === 'admin' || locals.user.role === 'manager')) { %>
      <button type="button" class="btn btn-primary bg-bank-primary border-0 btn-sm" data-bs-toggle="modal" data-bs-target="#newTontineModal">
        <i class="fa-solid fa-plus me-1"></i> Créer une tontine
      </button>
    <% } %>
  </div>
</div>

<!-- Statistiques / KPI -->
<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card shadow-sm border-0 border-start border-4 border-primary h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <span class="text-muted small fw-semibold text-uppercase">Mes Parts Sociales</span>
            <h3 class="fw-bold text-dark mb-0"><%= userTotalShares %> <small class="fs-6 text-muted">part(s)</small></h3>
          </div>
          <div class="bg-primary-subtle text-primary p-3 rounded-circle">
            <i class="fa-solid fa-certificate fa-lg"></i>
          </div>
        </div>
        <small class="text-muted mt-2 d-block">Valeur: <strong><%= Number(userTotalInvested).toFixed(2) %> €</strong></small>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card shadow-sm border-0 border-start border-4 border-success h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <span class="text-muted small fw-semibold text-uppercase">Capital Coopératif</span>
            <h3 class="fw-bold text-dark mb-0"><%= Number(coopStats.totalCapitalMobilized).toFixed(2) %> €</h3>
          </div>
          <div class="bg-success-subtle text-success p-3 rounded-circle">
            <i class="fa-solid fa-vault fa-lg"></i>
          </div>
        </div>
        <small class="text-muted mt-2 d-block">Total émis: <strong><%= coopStats.totalSharesIssued %></strong> parts</small>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card shadow-sm border-0 border-start border-4 border-info h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <span class="text-muted small fw-semibold text-uppercase">Tontines Actives</span>
            <h3 class="fw-bold text-dark mb-0"><%= tontines.length %></h3>
          </div>
          <div class="bg-info-subtle text-info p-3 rounded-circle">
            <i class="fa-solid fa-users-rays fa-lg"></i>
          </div>
        </div>
        <small class="text-muted mt-2 d-block">Épargne solidaire & rotative</small>
      </div>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card shadow-sm border-0 border-start border-4 border-warning h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <span class="text-muted small fw-semibold text-uppercase">Valeur Nominale</span>
            <h3 class="fw-bold text-dark mb-0">50.00 €</h3>
          </div>
          <div class="bg-warning-subtle text-warning p-3 rounded-circle">
            <i class="fa-solid fa-tag fa-lg"></i>
          </div>
        </div>
        <small class="text-muted mt-2 d-block">Droit de vote coopératif (1 part = 1 voix)</small>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- Section Mes Parts Sociales -->
  <div class="col-lg-6">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold text-dark mb-0">
          <i class="fa-solid fa-file-contract text-primary me-2"></i>Mon Portefeuille de Parts
        </h5>
        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#buySharesModal">
          <i class="fa-solid fa-plus me-1"></i> Acheter
        </button>
      </div>
      <div class="card-body">
        <% if (userShares && userShares.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>N° Certificat</th>
                  <th>Nb Parts</th>
                  <th>Montant</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% userShares.forEach(function(s) { %>
                  <tr>
                    <td>
                      <span class="badge bg-light text-dark border">
                        <i class="fa-solid fa-shield-halved text-success me-1"></i><%= s.certificateNo %>
                      </span>
                    </td>
                    <td class="fw-bold"><%= s.shareCount %></td>
                    <td class="fw-bold text-primary"><%= Number(s.totalAmount).toFixed(2) %> €</td>
                    <td class="small text-muted"><%= new Date(s.purchasedAt).toLocaleDateString('fr-FR') %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-5">
            <div class="text-muted mb-3">
              <i class="fa-solid fa-hand-holding-dollar fa-3x text-secondary"></i>
            </div>
            <h6 class="fw-bold text-dark">Vous ne détenez pas encore de parts sociales</h6>
            <p class="text-muted small mb-3">Participez au capital de la coopérative bancaire, soutenez les micro-crédits et percevez des ristournes annuelles.</p>
            <button type="button" class="btn btn-primary bg-bank-primary border-0 btn-sm" data-bs-toggle="modal" data-bs-target="#buySharesModal">
              <i class="fa-solid fa-cart-shopping me-1"></i> Souscrire ma première part (50 €)
            </button>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Section Tontines & Épargne Rotative -->
  <div class="col-lg-6">
    <div class="card shadow-sm h-100">
      <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold text-dark mb-0">
          <i class="fa-solid fa-rotate text-info me-2"></i>Cercles de Tontine & Épargne
        </h5>
        <% if (locals.user && (locals.user.role === 'admin' || locals.user.role === 'manager')) { %>
          <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#newTontineModal">
            <i class="fa-solid fa-plus me-1"></i> Nouvelle
          </button>
        <% } %>
      </div>
      <div class="card-body">
        <% if (tontines && tontines.length > 0) { %>
          <div class="row g-3">
            <% tontines.forEach(function(t) { %>
              <% const isMember = t.members.some(function(m) { return m.userId === locals.user.id; }); %>
              <div class="col-12">
                <div class="border rounded p-3 bg-light">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                      <h6 class="fw-bold text-dark mb-1"><%= t.name %></h6>
                      <small class="text-muted"><%= t.description || 'Cercle de solidarité financière' %></small>
                    </div>
                    <span class="badge <%= t.status === 'active' ? 'bg-success' : 'bg-secondary' %>">
                      <%= t.status === 'active' ? 'Active' : t.status %>
                    </span>
                  </div>

                  <div class="row g-2 small text-muted my-2">
                    <div class="col-6">
                      <i class="fa-solid fa-coins me-1 text-warning"></i> Cotisation : <strong><%= Number(t.contributionAmount).toFixed(2) %> €</strong>
                    </div>
                    <div class="col-6">
                      <i class="fa-solid fa-calendar me-1 text-primary"></i> Fréquence : <strong><%= t.frequency %></strong>
                    </div>
                    <div class="col-6">
                      <i class="fa-solid fa-users me-1 text-info"></i> Participants : <strong><%= t.members.length %> / <%= t.totalRounds %></strong>
                    </div>
                    <div class="col-6">
                      <i class="fa-solid fa-sack-dollar me-1 text-success"></i> Cagnotte : <strong><%= (Number(t.contributionAmount) * t.totalRounds).toFixed(2) %> €</strong>
                    </div>
                  </div>

                  <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                    <div>
                      <% if (isMember) { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                          <i class="fa-solid fa-check me-1"></i> Vous participez
                        </span>
                      <% } else { %>
                        <span class="small text-muted">Places restantes: <%= Math.max(0, t.totalRounds - t.members.length) %></span>
                      <% } %>
                    </div>
                    <div>
                      <% if (!isMember && t.status === 'active' && t.members.length < t.totalRounds) { %>
                        <form action="/cooperative/tontines/<%= t.id %>/join" method="POST" hx-post="/cooperative/tontines/<%= t.id %>/join" hx-target="#main-content" hx-push-url="true" class="d-inline">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn btn-sm btn-primary bg-bank-primary border-0">
                            <i class="fa-solid fa-user-plus me-1"></i> Rejoindre
                          </button>
                        </form>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="text-center py-5">
            <div class="text-muted mb-3">
              <i class="fa-solid fa-people-group fa-3x text-secondary"></i>
            </div>
            <h6 class="fw-bold text-dark">Aucune tontine active pour le moment</h6>
            <p class="text-muted small mb-0">Les cercles d'épargne rotative permettent de cotiser ensemble et de percevoir la cagnotte à tour de rôle.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Modal Souscription Parts Sociales -->
<div class="modal fade" id="buySharesModal" tabindex="-1" aria-labelledby="buySharesModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="buySharesModalLabel">
          <i class="fa-solid fa-certificate me-2 text-primary"></i>Souscrire des Parts Sociales
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>
      <form action="/cooperative/shares/buy" method="POST" hx-post="/cooperative/shares/buy" hx-target="#main-content" hx-push-url="true">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-body">
          <div class="alert alert-info py-2 small mb-3">
            <i class="fa-solid fa-circle-info me-1"></i>
            La valeur nominale fixée par les statuts est de <strong>50,00 €</strong> par part sociale. Le montant sera directement débité de votre compte.
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Compte à débiter <span class="text-danger">*</span></label>
            <select name="accountId" class="form-select" required>
              <option value="" disabled selected>-- Sélectionnez un compte --</option>
              <% if (userAccounts && userAccounts.length > 0) { %>
                <% userAccounts.forEach(function(acc) { %>
                  <option value="<%= acc.id %>">
                    <%= acc.accountNumber %> (<%= acc.type %>) - Solde : <%= Number(acc.balance).toFixed(2) %> €
                  </option>
                <% }); %>
              <% } %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Nombre de parts à acquérir <span class="text-danger">*</span></label>
            <input type="number" id="shareCountInput" name="shareCount" class="form-control" min="1" max="1000" value="1" required oninput="document.getElementById('totalCostDisplay').innerText = (this.value * 50).toFixed(2) + ' €'">
          </div>

          <div class="p-3 bg-light rounded text-center">
            <span class="text-muted small">Montant total de la souscription :</span>
            <h4 class="fw-bold text-primary mb-0 mt-1" id="totalCostDisplay">50.00 €</h4>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
          <button type="submit" class="btn btn-primary bg-bank-primary border-0">
            <i class="fa-solid fa-check me-1"></i> Confirmer la souscription
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal Création Tontine (Admin/Manager) -->
<% if (locals.user && (locals.user.role === 'admin' || locals.user.role === 'manager')) { %>
  <div class="modal fade" id="newTontineModal" tabindex="-1" aria-labelledby="newTontineModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title fw-bold" id="newTontineModalLabel">
            <i class="fa-solid fa-users-rays me-2 text-info"></i>Créer une Tontine Rotative
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
        </div>
        <form action="/cooperative/tontines" method="POST" hx-post="/cooperative/tontines" hx-target="#main-content" hx-push-url="true">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label fw-semibold">Nom du groupe de tontine <span class="text-danger">*</span></label>
              <input type="text" name="name" class="form-control" placeholder="ex: Tontine Solidarité Entrepreneurs" required minlength="2" maxlength="100">
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Description</label>
              <input type="text" name="description" class="form-control" placeholder="ex: Cycle d'épargne pour commerçants du marché">
            </div>

            <div class="row g-2 mb-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold">Cotisation (€) <span class="text-danger">*</span></label>
                <input type="number" step="0.01" min="10" name="contributionAmount" class="form-control" placeholder="ex: 100" required>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">Fréquence <span class="text-danger">*</span></label>
                <select name="frequency" class="form-select" required>
                  <option value="mensuelle" selected>Mensuelle</option>
                  <option value="bimensuelle">Bimensuelle</option>
                  <option value="hebdomadaire">Hebdomadaire</option>
                </select>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label fw-semibold">Nombre total de participants / tours <span class="text-danger">*</span></label>
              <input type="number" min="2" max="50" name="totalRounds" class="form-control" value="10" required>
              <small class="text-muted">Chaque participant cotise à chaque tour, et un participant gagne la cagnotte par tour.</small>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
            <button type="submit" class="btn btn-primary bg-bank-primary border-0">
              <i class="fa-solid fa-check me-1"></i> Lancer la tontine
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% } %>
