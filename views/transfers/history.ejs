<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold text-dark mb-1">Historique des Virements</h2>
    <p class="text-muted mb-0">Consultez l'ensemble des virements internes et externes émis et reçus.</p>
  </div>
  <div>
    <a href="/transfers" hx-get="/transfers" hx-target="#main-content" hx-push-url="true" class="btn btn-primary bg-bank-primary border-0 btn-sm">
      <i class="fa-solid fa-paper-plane me-1"></i> Nouveau virement
    </a>
  </div>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle data-table w-100">
        <thead class="table-light">
          <tr>
            <th>ID</th>
            <th>Date</th>
            <th>Type</th>
            <th>Compte Source</th>
            <th>Destinataire</th>
            <th>Montant</th>
            <th>Statut</th>
            <th>Description</th>
            <th>Initié par</th>
          </tr>
        </thead>
        <tbody>
          <% transfers.forEach(function(tr) { %>
            <tr>
              <td class="small text-muted">#<%= tr.id %></td>
              <td class="small text-muted"><%= new Date(tr.createdAt).toLocaleDateString('fr-FR') %> <%= new Date(tr.createdAt).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) %></td>
              <td>
                <span class="badge <%= tr.type === 'internal' ? 'bg-primary' : 'bg-success' %>">
                  <%= tr.type === 'internal' ? 'Interne' : 'Externe (SEPA)' %>
                </span>
              </td>
              <td class="fw-semibold">
                <% if (tr.sourceAccount) { %>
                  <a href="/accounts/<%= tr.sourceAccount.id %>" hx-get="/accounts/<%= tr.sourceAccount.id %>" hx-target="#main-content" hx-push-url="true" class="text-decoration-none">
                    <%= tr.sourceAccount.accountNumber %>
                  </a>
                <% } else { %>
                  #<%= tr.sourceAccountId %>
                <% } %>
              </td>
              <td>
                <% if (tr.type === 'internal' && tr.destinationAccount) { %>
                  <a href="/accounts/<%= tr.destinationAccount.id %>" hx-get="/accounts/<%= tr.destinationAccount.id %>" hx-target="#main-content" hx-push-url="true" class="text-decoration-none fw-semibold">
                    <%= tr.destinationAccount.accountNumber %>
                  </a>
                  <div class="small text-muted"><%= tr.destinationAccount.owner %></div>
                <% } else if (tr.externalDetails) { %>
                  <% try { const ext = JSON.parse(tr.externalDetails); %>
                    <div class="fw-semibold"><%= ext.beneficiaryName %></div>
                    <div class="small font-monospace text-muted"><%= ext.beneficiaryIban %></div>
                  <% } catch(e) { %>
                    <div class="small text-muted"><%= tr.externalDetails %></div>
                  <% } %>
                <% } else { %>
                  -
                <% } %>
              </td>
              <td class="fw-bold text-dark fs-6"><%= Number(tr.amount).toFixed(2) %> €</td>
              <td>
                <% if (tr.status === 'completed') { %>
                  <span class="badge bg-success">Complété</span>
                <% } else if (tr.status === 'pending') { %>
                  <span class="badge bg-warning text-dark">En attente</span>
                <% } else if (tr.status === 'failed') { %>
                  <span class="badge bg-danger">Échoué</span>
                <% } else { %>
                  <span class="badge bg-secondary"><%= tr.status %></span>
                <% } %>
              </td>
              <td class="small text-muted"><%= tr.description || '-' %></td>
              <td class="small text-muted"><%= tr.performedBy %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
