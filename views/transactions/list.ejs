<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold text-dark mb-1"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Transactions Bancaires' %></h2>
    <p class="text-muted mb-0">Historique complet des mouvements financiers et opérations de caisse.</p>
  </div>
  <% if (typeof account !== 'undefined' && account) { %>
    <div>
      <a href="/accounts/<%= account.id %>/transactions/create" hx-get="/accounts/<%= account.id %>/transactions/create" hx-target="#main-content" hx-push-url="true" class="btn btn-primary bg-bank-primary border-0 btn-sm">
        <i class="fa-solid fa-plus me-1"></i> Nouvelle opération
      </a>
    </div>
  <% } %>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle data-table w-100">
        <thead class="table-light">
          <tr>
            <th>ID</th>
            <th>Date</th>
            <th>Compte</th>
            <th>Type</th>
            <th>Description</th>
            <th>Montant</th>
            <th>Frais</th>
            <th>Solde Après</th>
            <th>Opérateur</th>
          </tr>
        </thead>
        <tbody>
          <% transactions.forEach(function(tx) { %>
            <tr>
              <td class="small text-muted">#<%= tx.id %></td>
              <td class="small text-muted"><%= new Date(tx.createdAt).toLocaleDateString('fr-FR') %> <%= new Date(tx.createdAt).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) %></td>
              <td class="fw-semibold">
                <% if (tx.account) { %>
                  <a href="/accounts/<%= tx.account.id %>" hx-get="/accounts/<%= tx.account.id %>" hx-target="#main-content" hx-push-url="true" class="text-decoration-none">
                    <%= tx.account.accountNumber %>
                  </a>
                  <div class="small text-muted"><%= tx.account.owner %></div>
                <% } else { %>
                  Compte #<%= tx.accountId %>
                <% } %>
              </td>
              <td>
                <span class="badge <%= tx.type === 'deposit' ? 'bg-success' : (tx.type === 'interest' ? 'bg-info text-dark' : 'bg-danger') %>">
                  <%= tx.type === 'deposit' ? 'Dépôt' : (tx.type === 'interest' ? 'Intérêts' : 'Retrait') %>
                </span>
              </td>
              <td class="small"><%= tx.description || '-' %></td>
              <td class="fw-bold <%= tx.type === 'withdrawal' ? 'amount-negative' : 'amount-positive' %>">
                <%= tx.type === 'withdrawal' ? '-' : '+' %><%= Number(tx.amount).toFixed(2) %> €
              </td>
              <td class="small text-muted"><%= Number(tx.fee).toFixed(2) %> €</td>
              <td class="fw-semibold"><%= Number(tx.balanceAfter).toFixed(2) %> €</td>
              <td class="small text-muted"><%= tx.performedBy %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
