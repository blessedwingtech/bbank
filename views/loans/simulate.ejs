<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold text-dark mb-1">Simulateur de Micro-Crédit</h2>
    <p class="text-muted mb-0">Calculez instantanément vos mensualités et votre tableau d'amortissement.</p>
  </div>
  <% if (locals.user && locals.user.role === 'user') { %>
    <div>
      <a href="/loans/apply" hx-get="/loans/apply" hx-target="#main-content" hx-push-url="true" class="btn btn-primary bg-bank-primary border-0 btn-sm">
        <i class="fa-solid fa-file-signature me-1"></i> Déposer une demande
      </a>
    </div>
  <% } %>
</div>

<div class="row justify-content-center">
  <div class="col-12 col-lg-8">
    <div class="card shadow-sm border-0">
      <div class="card-body p-4">
        <form action="/loans/simulate" method="POST" hx-post="/loans/simulate" hx-target="#simulation-output">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="row g-3">
            <div class="col-12 col-md-6">
              <label for="amount" class="form-label fw-semibold">Montant souhaité (€)</label>
              <div class="input-group">
                <input type="number" step="50" min="50" max="100000" class="form-control" id="amount" name="amount" value="2500" required>
                <span class="input-group-text bg-white">EUR (€)</span>
              </div>
            </div>

            <div class="col-12 col-md-6">
              <label for="durationMonths" class="form-label fw-semibold">Durée (Mois)</label>
              <input type="number" min="1" max="120" class="form-control" id="durationMonths" name="durationMonths" value="12" required>
            </div>

            <div class="col-12 col-md-6">
              <label for="annualRate" class="form-label fw-semibold">Taux d'intérêt annuel (%)</label>
              <div class="input-group">
                <input type="number" step="0.1" min="0" max="50" class="form-control" id="annualRate" name="annualRate" value="9.5" required>
                <span class="input-group-text bg-white">%</span>
              </div>
            </div>

            <div class="col-12 col-md-6">
              <label for="method" class="form-label fw-semibold">Méthode de calcul</label>
              <select class="form-select" id="method" name="method">
                <option value="declining_balance" selected>Amortissement Dégressif (Annuités constantes)</option>
                <option value="flat">Taux Constant (Flat Rate)</option>
              </select>
            </div>
          </div>

          <div class="mt-4 d-flex justify-content-end">
            <button type="submit" class="btn btn-primary bg-bank-primary border-0 px-4">
              <i class="fa-solid fa-calculator me-1"></i> Calculer l'échéancier
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Output container for HTMX -->
    <div id="simulation-output"></div>
  </div>
</div>
