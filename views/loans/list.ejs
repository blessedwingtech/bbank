<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold text-dark mb-1">Dossiers de Micro-Crédit</h2>
    <p class="text-muted mb-0">Suivi des demandes de prêt, déblocages et remboursements d'échéances.</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/loans/simulate" hx-get="/loans/simulate" hx-target="#main-content" hx-push-url="true" class="btn btn-outline-primary btn-sm">
      <i class="fa-solid fa-calculator me-1"></i> Simulateur
    </a>
    <% if (locals.user && locals.user.role === 'user') { %>
      <a href="/loans/apply" hx-get="/loans/apply" hx-target="#main-content" hx-push-url="true" class="btn btn-primary bg-bank-primary border-0 btn-sm">
        <i class="fa-solid fa-plus me-1"></i> Nouvelle demande
      </a>
    <% } %>
  </div>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle data-table w-100">
        <thead class="table-light">
          <tr>
            <th>N° Dossier</th>
            <th>Emprunteur</th>
            <th>Produit</th>
            <th>Montant</th>
            <th>Durée</th>
            <th>Taux</th>
            <th>Statut</th>
            <th>Date</th>
            <th class="text-end">Action</th>
          </tr>
        </thead>
        <tbody>
          <% loans.forEach(function(l) { %>
            <tr>
              <td class="fw-bold">
                <a href="/loans/<%= l.id %>" hx-get="/loans/<%= l.id %>" hx-target="#main-content" hx-push-url="true" class="text-decoration-none">
                  <%= l.loanNumber %>
                </a>
              </td>
              <td>
                <div class="fw-semibold"><%= l.user.firstName ? l.user.firstName + ' ' + (l.user.lastName || '') : l.user.username %></div>
                <div class="small text-muted"><%= l.user.email %></div>
              </td>
              <td>
                <span class="badge bg-light text-dark border"><%= l.product ? l.product.name : 'Standard' %></span>
              </td>
              <td class="fw-bold text-dark"><%= Number(l.amountRequested).toFixed(2) %> €</td>
              <td><%= l.durationMonths %> mois</td>
              <td><%= Number(l.interestRate).toFixed(2) %>%</td>
              <td>
                <% if (l.status === 'submitted') { %>
                  <span class="badge bg-warning text-dark">Soumis</span>
                <% } else if (l.status === 'approved') { %>
                  <span class="badge bg-info text-dark">Approuvé</span>
                <% } else if (l.status === 'disbursed') { %>
                  <span class="badge bg-primary">Débloqué / En cours</span>
                <% } else if (l.status === 'repaid') { %>
                  <span class="badge bg-success">Soldé / Remboursé</span>
                <% } else if (l.status === 'rejected') { %>
                  <span class="badge bg-danger">Rejeté</span>
                <% } else { %>
                  <span class="badge bg-secondary"><%= l.status %></span>
                <% } %>
              </td>
              <td class="small text-muted"><%= new Date(l.createdAt).toLocaleDateString('fr-FR') %></td>
              <td class="text-end">
                <a href="/loans/<%= l.id %>" hx-get="/loans/<%= l.id %>" hx-target="#main-content" hx-push-url="true" class="btn btn-outline-primary btn-sm">
                  <i class="fa-solid fa-eye me-1"></i> Détails
                </a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
