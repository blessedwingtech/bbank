<div class="card shadow-sm border-0 border-top border-4 border-success mt-4">
  <div class="card-body p-4">
    <div class="row g-3 text-center mb-4">
      <div class="col-6 col-md-3 border-end">
        <div class="text-muted small">Montant Emprunté</div>
        <div class="fs-4 fw-bold text-dark"><%= result.amount.toFixed(2) %> €</div>
      </div>
      <div class="col-6 col-md-3 border-end">
        <div class="text-muted small">Mensualité Estimée</div>
        <div class="fs-4 fw-bold text-primary"><%= result.monthlyPayment.toFixed(2) %> €</div>
      </div>
      <div class="col-6 col-md-3 border-end">
        <div class="text-muted small">Total Intérêts</div>
        <div class="fs-4 fw-bold text-danger">+<%= result.totalInterest.toFixed(2) %> €</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="text-muted small">Total à Rembourser</div>
        <div class="fs-4 fw-bold text-dark"><%= result.totalRepayable.toFixed(2) %> €</div>
      </div>
    </div>

    <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-table me-1"></i> Échéancier Prévisionnel d'Amortissement (<%= result.method === 'flat' ? 'Taux Constant / Flat' : 'Amortissement Dégressif' %>)</h6>
    <div class="table-responsive">
      <table class="table table-sm table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>N°</th>
            <th>Date d'échéance</th>
            <th>Part Capital</th>
            <th>Part Intérêt</th>
            <th>Mensualité</th>
            <th>Capital Restant Dû</th>
          </tr>
        </thead>
        <tbody>
          <% result.schedule.forEach(function(inst) { %>
            <tr>
              <td class="fw-bold">#<%= inst.installmentNumber %></td>
              <td class="small text-muted"><%= new Date(inst.dueDate).toLocaleDateString('fr-FR') %></td>
              <td><%= inst.principalAmount.toFixed(2) %> €</td>
              <td class="text-danger">+<%= inst.interestAmount.toFixed(2) %> €</td>
              <td class="fw-bold text-primary"><%= inst.totalDue.toFixed(2) %> €</td>
              <td class="small text-muted"><%= inst.remainingBalance.toFixed(2) %> €</td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
