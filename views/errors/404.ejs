<div class="row justify-content-center align-items-center" style="min-height: 60vh;">
  <div class="col-12 col-md-8 col-lg-6 text-center">
    <div class="display-1 text-warning fw-bold mb-3">404</div>
    <h3 class="fw-bold text-dark mb-2">Page Non Trouvée</h3>
    <p class="text-muted mb-4"><%= typeof message !== 'undefined' ? message : "La ressource ou la page que vous recherchez semble introuvable ou a été déplacée." %></p>
    <div class="d-flex justify-content-center gap-2">
      <a href="/dashboard" hx-get="/dashboard" hx-target="#main-content" hx-push-url="true" class="btn btn-primary bg-bank-primary border-0">
        <i class="fa-solid fa-house me-1"></i> Retour au tableau de bord
      </a>
      <a href="javascript:history.back()" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i> Page précédente
      </a>
    </div>
  </div>
</div>
