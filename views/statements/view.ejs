<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="fw-bold text-dark mb-1">Relevé de Compte Bancaire</h2>
    <p class="text-muted mb-0">
      Compte : <strong><%= account.accountNumber %></strong> | Titulaire : <strong><%= account.owner %></strong>
    </p>
  </div>
  <div class="d-flex gap-2">
    <a href="/statements" hx-get="/statements" hx-target="#main-content" hx-push-url="true" class="btn btn-outline-secondary btn-sm">
      <i class="fa-solid fa-arrow-left me-1"></i> Autres comptes
    </a>
    <a href="/statements/<%= account.id %>/download?startDate=<%= filter.startDate || '' %>&endDate=<%= filter.endDate || '' %>" class="btn btn-danger btn-sm">
      <i class="fa-solid fa-file-pdf me-1"></i> Télécharger en PDF
    </a>
  </div>
</div>

<!-- Statement Summary Box -->
<div class="card shadow-sm mb-4">
  <div class="card-body p-4">
    <div class="row g-3 text-center">
      <div class="col-6 col-md-3 border-end">
        <div class="text-muted small">Solde d'Ouverture</div>
        <div class="fs-4 fw-bold text-dark mt-1"><%= openingBalance.toFixed(2) %> €</div>
      </div>
      <div class="col-6 col-md-3 border-end">
        <div class="text-muted small">Total Dépôts / Crédits</div>
        <div class="fs-4 fw-bold text-success mt-1">+<%= totalDeposits.toFixed(2) %> €</div>
      </div>
      <div class="col-6 col-md-3 border-end">
        <div class="text-muted small">Total Retraits / Débits</div>
        <div class="fs-4 fw-bold text-danger mt-1">-<%= totalWithdrawals.toFixed(2) %> €</div>
      </div>
      <div class="col-6 col-md-3">
        <div class="text-muted small">Solde de Clôture</div>
        <div class="fs-4 fw-bold text-primary mt-1"><%= closingBalance.toFixed(2) %> €</div>
      </div>
    </div>
  </div>
</div>

<!-- Transactions Table in Statement -->
<div class="card shadow-sm mb-4">
  <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
    <h5 class="fw-bold mb-0 text-dark">Détail des opérations de la période</h5>
    <span class="badge bg-light text-muted border">Total Frais : <%= totalFees.toFixed(2) %> €</span>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Date</th>
            <th>Type</th>
            <th>Description</th>
            <th>Montant</th>
            <th>Frais</th>
            <th>Solde Après</th>
          </tr>
        </thead>
        <tbody>
          <% if (transactions.length === 0) { %>
            <tr><td colspan="6" class="text-center py-4 text-muted">Aucune transaction enregistrée pour les dates sélectionnées.</td></tr>
          <% } else { %>
            <% transactions.forEach(function(tx) { %>
              <tr>
                <td class="small text-muted"><%= new Date(tx.createdAt).toLocaleDateString('fr-FR') %></td>
                <td>
                  <span class="badge <%= tx.type === 'deposit' ? 'bg-success' : (tx.type === 'interest' ? 'bg-info text-dark' : 'bg-danger') %>">
                    <%= tx.type === 'deposit' ? 'Dépôt' : (tx.type === 'interest' ? 'Intérêts' : 'Retrait') %>
                  </span>
                </td>
                <td class="small"><%= tx.description || '-' %></td>
                <td class="fw-bold <%= tx.type === 'withdrawal' ? 'amount-negative' : 'amount-positive' %>">
                  <%= tx.type === 'withdrawal' ? '-' : '+' %><%= Number(tx.amount).toFixed(2) %> €
                </td>
                <td class="small text-muted"><%= Number(tx.fee).toFixed(2) %> €</td>
                <td class="fw-semibold"><%= Number(tx.balanceAfter).toFixed(2) %> €</td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
