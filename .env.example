# Application
APP_PORT=3000
NODE_ENV=development

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/banking?schema=public"

# Session
SESSION_SECRET=bbank_super_secret_session_key_64_characters_long_banking_secure_2025
SESSION_MAX_AGE=86400000

# Session DB (pour PostgreSQL session store)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=banking

# Security
BCRYPT_SALT_ROUNDS=12
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Interest
SAVINGS_INTEREST_RATE=0.005
