generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  manager
  user
}

enum AccountType {
  checking
  savings
}

enum AccountStatus {
  active
  frozen
  closed
}

enum TransactionType {
  deposit
  withdrawal
  interest
  loan_disbursement
  loan_repayment
}

enum TransferType {
  internal
  external
}

enum TransferStatus {
  pending
  completed
  failed
  cancelled
}

enum FeeType {
  withdrawal_fee
  deposit_fee
  transfer_fee
  monthly_fee
  loan_origination_fee
  loan_late_penalty
}

enum InstitutionType {
  bank
  microfinance
  cooperative
  mutuelle
}

enum InterestCalculationMethod {
  flat
  declining_balance
}

enum LoanStatus {
  submitted
  under_review
  approved
  disbursed
  rejected
  repaid
  defaulted
}

enum ScheduleStatus {
  pending
  paid
  partially_paid
  overdue
}

enum GuaranteeType {
  collateral_asset
  salary
  personal_guarantor
}

model SystemSetting {
  id                    Int             @id @default(autoincrement())
  institutionName       String          @default("B-Bank Pro") @db.VarChar(100)
  institutionType       InstitutionType @default(microfinance)
  enableMicrocredit     Boolean         @default(true)
  enableCooperative     Boolean         @default(true)
  enableTontine         Boolean         @default(true)
  enableStandardBank    Boolean         @default(true)
  enable2FAForTransfers Boolean         @default(false)
  maxDailyTransferLimit Decimal         @default(5000.00) @db.Decimal(15, 2)
  defaultCurrency       String          @default("EUR") @db.VarChar(10)
  updatedAt             DateTime        @updatedAt

  @@map("system_settings")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(30)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255) // bcrypt hash — JAMAIS exposé
  firstName String?  @db.VarChar(100)
  lastName  String?  @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  address   String?  @db.VarChar(255)
  role      Role     @default(user)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  loans             Loan[]
  cooperativeShares CooperativeShare[]
  tontineMembers    TontineMember[]

  @@map("users")
}

model Account {
  id                  Int           @id @default(autoincrement())
  accountNumber       String        @unique @db.VarChar(20) // Format: "BB-XXXXXXXX"
  owner               String        @db.VarChar(100)
  accountType         AccountType
  balance             Decimal       @default(0) @db.Decimal(15, 2)
  accumulatedInterest Decimal       @default(0) @db.Decimal(15, 2)
  status              AccountStatus @default(active)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id])

  transactions      Transaction[]
  fees              Fee[]
  outgoingTransfers Transfer[]    @relation("SourceAccount")
  incomingTransfers Transfer[]    @relation("DestinationAccount")
  loans             Loan[]

  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id           Int             @id @default(autoincrement())
  amount       Decimal         @db.Decimal(15, 2)
  type         TransactionType
  fee          Decimal         @default(0) @db.Decimal(10, 2)
  balanceAfter Decimal         @db.Decimal(15, 2)
  description  String?         @db.VarChar(255)
  performedBy  String          @db.VarChar(100)
  createdAt    DateTime        @default(now())

  accountId Int
  account   Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([createdAt])
  @@map("transactions")
}

model Transfer {
  id              Int            @id @default(autoincrement())
  amount          Decimal        @db.Decimal(15, 2)
  type            TransferType
  status          TransferStatus @default(pending)
  externalDetails String?        @db.VarChar(500)
  description     String?        @db.VarChar(255)
  performedBy     String         @db.VarChar(100)
  createdAt       DateTime       @default(now())
  completedAt     DateTime?

  sourceAccountId      Int
  sourceAccount        Account  @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccountId Int?
  destinationAccount   Account? @relation("DestinationAccount", fields: [destinationAccountId], references: [id])

  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@map("transfers")
}

model Fee {
  id          Int      @id @default(autoincrement())
  type        FeeType
  amount      Decimal  @db.Decimal(10, 2)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())

  accountId Int
  account   Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("fees")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @default(0)
  username  String   @db.VarChar(100)
  action    String   @db.VarChar(255)
  method    String   @db.VarChar(10)
  url       String   @db.VarChar(500)
  ip        String   @db.VarChar(45)
  details   String   @db.Text
  timestamp DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ==========================================
// MODULE : MICRO-CRÉDIT & PRÊTS
// ==========================================

model LoanProduct {
  id                 Int                       @id @default(autoincrement())
  name               String                    @db.VarChar(100)
  description        String?                   @db.VarChar(255)
  interestRate       Decimal                   @db.Decimal(5, 2) // Taux annuel (ex: 12.00%)
  interestMethod     InterestCalculationMethod @default(declining_balance)
  minAmount          Decimal                   @db.Decimal(15, 2)
  maxAmount          Decimal                   @db.Decimal(15, 2)
  minDurationMonths  Int                       @default(1)
  maxDurationMonths  Int                       @default(36)
  penaltyRateDaily   Decimal                   @default(0.05) @db.Decimal(5, 2) // % pénalité / jour de retard
  isActive           Boolean                   @default(true)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  loans Loan[]

  @@map("loan_products")
}

model Loan {
  id               Int                       @id @default(autoincrement())
  loanNumber       String                    @unique @db.VarChar(25) // Format: "LN-XXXXXXXX"
  amountRequested  Decimal                   @db.Decimal(15, 2)
  amountApproved   Decimal?                  @db.Decimal(15, 2)
  durationMonths   Int
  interestRate     Decimal                   @db.Decimal(5, 2)
  interestMethod   InterestCalculationMethod
  totalInterest    Decimal                   @default(0) @db.Decimal(15, 2)
  totalRepayable   Decimal                   @default(0) @db.Decimal(15, 2)
  monthlyPayment   Decimal                   @default(0) @db.Decimal(15, 2)
  status           LoanStatus                @default(submitted)
  purpose          String                    @db.VarChar(255)
  rejectionReason  String?                   @db.VarChar(255)
  disbursedAt      DateTime?
  repaidAt         DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id])

  accountId Int // Compte sur lequel débloquer les fonds et prélever les remboursements
  account   Account @relation(fields: [accountId], references: [id])

  productId Int
  product   LoanProduct @relation(fields: [productId], references: [id])

  schedules  LoanRepaymentSchedule[]
  guarantees LoanGuarantee[]

  @@index([userId])
  @@index([accountId])
  @@index([status])
  @@map("loans")
}

model LoanRepaymentSchedule {
  id                Int            @id @default(autoincrement())
  installmentNumber Int
  dueDate           DateTime
  principalAmount   Decimal        @db.Decimal(15, 2)
  interestAmount    Decimal        @db.Decimal(15, 2)
  totalDue          Decimal        @db.Decimal(15, 2)
  amountPaid        Decimal        @default(0) @db.Decimal(15, 2)
  penaltyAmount     Decimal        @default(0) @db.Decimal(15, 2)
  status            ScheduleStatus @default(pending)
  paidAt            DateTime?

  loanId Int
  loan   Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@index([dueDate])
  @@index([status])
  @@map("loan_repayment_schedules")
}

model LoanGuarantee {
  id              Int           @id @default(autoincrement())
  type            GuaranteeType
  value           Decimal       @db.Decimal(15, 2)
  description     String        @db.VarChar(255)
  guarantorName   String?       @db.VarChar(100)
  guarantorPhone  String?       @db.VarChar(20)

  loanId Int
  loan   Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@map("loan_guarantees")
}

// ==========================================
// MODULE : MUTUELLE, COOPÉRATIVE & TONTINES
// ==========================================

model CooperativeShare {
  id           Int      @id @default(autoincrement())
  shareCount   Int
  nominalValue Decimal  @default(50.00) @db.Decimal(10, 2)
  totalAmount  Decimal  @db.Decimal(15, 2)
  purchasedAt  DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("cooperative_shares")
}

model Tontine {
  id                 Int             @id @default(autoincrement())
  name               String          @db.VarChar(100)
  description        String?         @db.VarChar(255)
  contributionAmount Decimal         @db.Decimal(15, 2)
  frequency          String          @default("monthly") @db.VarChar(20)
  totalRounds        Int
  status             String          @default("active") @db.VarChar(20)
  createdAt          DateTime        @default(now())

  members TontineMember[]

  @@map("tontines")
}

model TontineMember {
  id             Int       @id @default(autoincrement())
  turnOrder      Int
  hasReceivedPot Boolean   @default(false)
  receivedAt     DateTime?

  tontineId Int
  tontine   Tontine @relation(fields: [tontineId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@unique([tontineId, userId])
  @@index([tontineId])
  @@index([userId])
  @@map("tontine_members")
}
